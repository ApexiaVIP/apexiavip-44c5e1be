# Google's map on the chauffeur driving screen. Both are needed before it will
# draw; without them the screen falls back to the open map.
#
# The key is restricted to the Maps JavaScript API and to the referrers
# apexiavip.com and capacitor://localhost. It ships inside the app bundle, as
# every browser map key does, so the referrer restriction is what protects it.
# Keep it separate from the server side GOOGLE_MAPS_API_KEY, which also has
# Places and Routes on it and must never reach a browser.
#
# The map id must be a vector map with tilt and rotation turned on. Only a
# vector map can be tilted and turned to face the way the car is going.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
